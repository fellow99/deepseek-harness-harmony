+/**
+ * Writable roots a deployment grants on top of the mode's meaning, read from
+ * `DSH_EXTRA_WRITABLE_ROOTS` (entries separated by `path.delimiter`). A product
+ * whose users routinely ask the agent to write into their own desktop,
+ * documents, or downloads directory names those directories here once at
+ * startup, instead of leaving every such write to a per-operation escalation.
+ *
+ * The variable is deployment state, not model input: no capability in the
+ * composition can set it, so granting a root is a decision the embedding
+ * product makes and the model cannot widen on its own.
+ * @returns the configured extra roots in their given spelling, or empty when
+ *   the variable is unset or holds no non-empty entry.
+ */
+function extraWritableRoots(): string[] {
+  const configured = process.env.DSH_EXTRA_WRITABLE_ROOTS
+  if (configured === undefined) return []
+  return configured.split(delimiter).map(entry => entry.trim()).filter(entry => entry.length > 0)
+}
+
 /**
  * The roots one confined execution may WRITE under — the mode's meaning as a
  * canonical, deduplicated allow-list. `read-only` allows nothing;
- * `workspace-write` allows the policy's workspace root, the host `/tmp`, and
- * the per-user platform temp dir (`os.tmpdir()` — the real temp area for
- * mkstemp-family tools; omitting it would deny what the mode promises).
+ * `workspace-write` allows the policy's workspace root, the host `/tmp`, the
+ * per-user platform temp dir (`os.tmpdir()` — the real temp area for
+ * mkstemp-family tools; omitting it would deny what the mode promises), and
+ * every deployment-granted {@link extraWritableRoots | extra root}.
  * @param policy - the file-effect policy to derive the allow-list from.
  * @returns the canonical writable roots; empty exactly under `read-only`.
  */
 export function writableRoots(policy: SandboxExecutionPolicy): string[] {
   if (policy.mode !== 'workspace-write') return []
-  return [...new Set([policy.workspaceRoot, '/tmp', tmpdir()].map(canonicalPath))]
+  return [...new Set([policy.workspaceRoot, '/tmp', tmpdir(), ...extraWritableRoots()].map(canonicalPath))]
 }
