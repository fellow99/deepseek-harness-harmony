+/**
+ * Whether the platform refused to open a directory handle. HarmonyOS denies
+ * opening the mount points above the application data root — `/`, `/data`,
+ * `/data/storage`, and `/data/storage/el2` all raise `EACCES` — so the ancestor
+ * durability walk below must treat such a level as outside its reach rather
+ * than failing the save. Those boot-time mount points are created and owned by
+ * the system, so their entry durability is not this process's to prove.
+ * @param error - the rejection raised while opening a directory.
+ * @returns whether the open was refused by the platform's access policy.
+ */
+function isOpenRefused(error: unknown): boolean {
+  if (!(error instanceof Error) || !('code' in error)) return false
+  const { code } = error
+  return code === 'EACCES' || code === 'EPERM'
+}
