diff --git a/packages/session/session-persistence-jsonl/src/openharmony.ts b/packages/session/session-persistence-jsonl/src/openharmony.ts
new file mode 100644
index 0000000000..fcfdda321c
--- /dev/null
+++ b/packages/session/session-persistence-jsonl/src/openharmony.ts
@@ -0,0 +1,40 @@
+/**
+ * Exclusive Session-artifact publication for sandboxes that refuse hard links.
+ *
+ * POSIX publication links a staged file into its canonical name so a same-id
+ * race fails instead of overwriting a committed artifact. The HarmonyOS sandbox
+ * refuses hard links with `EACCES`, so this module keeps the link preference and
+ * renames where the sandbox refuses.
+ * @module @deepseek-ai/dsh-session-persistence-jsonl/openharmony
+ */
+
+import { link, rename } from 'node:fs/promises'
+
+/** Errno codes a filesystem returns when it refuses to create a hard link. */
+function isHardLinkRefused(error: unknown): boolean {
+  const code = (error as NodeJS.ErrnoException | null)?.code
+  return code === 'EACCES' || code === 'EPERM' || code === 'ENOSYS' || code === 'EOPNOTSUPP'
+}
+
+/**
+ * Publish a staged file at its canonical path without overwriting a committed file.
+ *
+ * `link()` publishes atomically and fails with `EEXIST` when the canonical path
+ * already exists, so two processes racing for the same artifact cannot clobber
+ * each other. Where the sandbox refuses hard links, the same-directory
+ * `rename()` fallback publishes the staged bytes in one atomic step; callers
+ * reject an existing canonical artifact before staging, and the HarmonyOS host
+ * is a single process whose in-process write claim already excludes a competing
+ * writer for the same Session.
+ *
+ * @param existingPath - The fsynced staged file to publish.
+ * @param newPath - The canonical path the published artifact must acquire.
+ */
+export async function publishExclusiveFile(existingPath: string, newPath: string): Promise<void> {
+  try {
+    await link(existingPath, newPath)
+  } catch (error) {
+    if (!isHardLinkRefused(error)) throw error
+    await rename(existingPath, newPath)
+  }
+}
