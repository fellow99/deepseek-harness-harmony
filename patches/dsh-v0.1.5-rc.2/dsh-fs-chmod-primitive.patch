+/**
+ * Raw permission-change mechanics for the local `ctx.fs` backend. Kept beside
+ * `fsio.ts` rather than inside it so a sandbox-fenced permission change composes
+ * with the read/write/edit primitives without widening the atomic-write module.
+ * @module @deepseek-ai/dsh-fs-local/chmod
+ */
+
+import { chmod, stat } from 'node:fs/promises'
+import { FsError } from '@deepseek-ai/dsh-fs'
+
+/** Mask selecting only the permission and setuid/setgid/sticky bits. */
+const PERMISSION_BITS = 0o7777
+
+/**
+ * Apply permission bits to a path and read them back, so a storage layer that
+ * accepts the call while ignoring the mode fails loudly instead of reporting a
+ * change it never made. The mode follows a final symlink, as `chmod(2)` does, so
+ * the reported bits describe the entry the caller reached.
+ * @param absolutePath - the canonical path to change (typically a target key).
+ * @param mode - the POSIX permission bits to apply; only `0o7777` is considered.
+ * @param signal - aborts before the change (`FS_ABORTED`).
+ * @returns the permission bits read back after the change.
+ */
+export async function chmodPath(
+  absolutePath: string,
+  mode: number,
+  signal?: AbortSignal,
+): Promise<number> {
+  if (signal?.aborted) throw new FsError('chmod aborted', 'FS_ABORTED')
+  const requested = mode & PERMISSION_BITS
+  try {
+    await chmod(absolutePath, requested)
+  } catch (error: unknown) {
+    const code = (error as NodeJS.ErrnoException | null)?.code
+    if (code === 'ENOENT' || code === 'ENOTDIR') {
+      throw new FsError(`cannot chmod "${absolutePath}": not found`, 'FS_NOT_FOUND')
+    }
+    throw error
+  }
+  const applied = (await stat(absolutePath)).mode & PERMISSION_BITS
+  if (applied !== requested) {
+    throw new FsError(
+      `cannot chmod "${absolutePath}": the filesystem kept mode ${applied.toString(8)} instead of ${requested.toString(8)}`,
+      'FS_IO_ERROR',
+    )
+  }
+  return applied
+}
