+/**
+ * A filesystem that does not implement hard links refuses `link()` with one of
+ * these codes instead of creating the entry. HarmonyOS hmdfs reports `EPERM`
+ * because its local directory inode operations export no `.link` handler.
+ */
+function isHardLinkRefused(error: unknown): boolean {
+  if (!(error instanceof Error) || !('code' in error)) return false
+  const { code } = error
+  return code === 'EACCES' || code === 'EPERM' || code === 'ENOSYS'
+    || code === 'EOPNOTSUPP' || code === 'ENOTSUP' || code === 'EXDEV'
+}
+
+/**
+ * Whether the publication target is absent, which decides whether a
+ * link-refusing filesystem may publish the staged file by rename instead. An
+ * unreadable target counts as present so the caller keeps its structured
+ * guard-failure path.
+ *
+ * @param absolutePath - the canonical path this write intends to create.
+ * @param inspectPublicationTarget - the `lstat`-based probe supplied by the caller.
+ * @returns `true` only when the probe reports that the target does not exist.
+ */
+async function isTargetAbsent(
+  absolutePath: string,
+  inspectPublicationTarget: (path: string) => Promise<BigIntStats>,
+): Promise<boolean> {
+  try {
+    await inspectPublicationTarget(absolutePath)
+    return false
+  } catch (error: unknown) {
+    return isENOENT(error) || isENOTDIR(error)
+  }
+}
